# Copy this file to .env and fill in real values. Never commit .env with real secrets.

# App
APP_NAME=DevTrack
APP_ENV=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://devtrack:devtrack@db:5432/devtrack
POSTGRES_USER=devtrack
POSTGRES_PASSWORD=devtrack
POSTGRES_DB=devtrack

# JWT
SECRET_KEY=replace-with-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
DASHBOARD_CACHE_TTL_SECONDS=60

# Logging
LOG_DIR=logs
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*
